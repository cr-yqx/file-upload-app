# Flask
SECRET_KEY=replace-with-a-secure-random-string
MAX_FILE_SIZE=10485760
UPLOAD_FOLDER=uploads

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/database

# Summary worker retry (local background thread)
SUMMARY_MAX_ATTEMPTS=2
SUMMARY_RETRY_DELAY_SECONDS=3

# OpenAI
OPENAI_API_KEY=sk-xxxx
OPENAI_MODEL=gpt-4o-mini
SUMMARY_MAX_TEXT_CHARS=20000
SUMMARY_MIN_TEXT_CHARS=80

# Default room compatibility
DEFAULT_ROOM_SLUG=demo
DEFAULT_ROOM_NAME=Demo Room
DEFAULT_ROOM_PASSCODE=demo1234
